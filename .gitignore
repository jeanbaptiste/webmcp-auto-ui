# Dependencies
node_modules/

# Build outputs
dist/
build/
.svelte-kit/

# Deploy fingerprint state (skip rebuild when sources unchanged)
.deploy-state/

# Deploy ETA cache (timings history) and script backups
.deploy-cache/
*.back

# Environment
.env
.env.*
!.env.example

# Healthcheck credentials (basic auth for deploy.sh)
.netrc

# Canary test artefacts (Hawk Gemma tool-call validation)
scripts/test-hawk-gemma-canary.mjs
scripts/test-hawk-gemma-toolcall.mjs
scripts/canary-screenshots/
scripts/canary-results.json

# Logs
*.log
npm-debug.log*
logs/

# Editor
.DS_Store
.vscode/
.idea/

# TypeScript incremental build cache
*.tsbuildinfo

# Playwright test output
test-results/
playwright-report/

# TypeScript declaration files (build artifacts in src/)
packages/core/src/*.d.ts

# Astro cache
docs/starlight/.astro/

# Auto-generated recipe file
packages/agent/src/recipes/_generated.ts

# Generated documentation artifacts
docs/diagrams/svg/
docs/generated/

# Local
*.local

# Docs sync artefacts (regenerated by scripts/docs-update.mjs)
.docs-lastrun
.docs-manifest.json
.docs-snapshot-light.txt

# Lockfile fantôme (le repo utilise npm — voir .npmrc + package-lock.json)
pnpm-lock.yaml

# Sub-agent refactor reports (artefacts internes, hors scope du repo)
.refactor-reports/

# Python bytecode (mcp-proxies)
__pycache__/
*.pyc

# Race-check / debug artifacts (Playwright sampling outputs)
.notes/race-check*

# Recipe audit (Playwright harness outputs, screenshots, judgments)
.notes/recipe-audit/
